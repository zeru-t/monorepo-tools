{
	"name": "monorepo-tools",
	"displayName": "Monorepo Tools",
	"description": "A set of tools to help manage a monorepo",
	"version": "0.0.1",
	"publisher": "ztessema",
	"repository": "https://github.com/zeru-t/monorepo-tools",
	"license": "MIT",
	"author": {
		"name": "ztessema",
		"url": "https://github.com/zeru-t"
	},
	"engines": {
		"vscode": "^1.134.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"views": {
			"explorer": [
				{
					"id": "monorepo-dependencies",
					"name": "Monorepo Dependencies",
					"icon": "$(list-tree)",
					"type": "tree"
				}
			]
		},
		"commands": [
			{
				"command": "MonorepoTools.refreshDependencies",
				"title": "Refresh Dependencies",
				"icon": "$(refresh)"
			},
			{
				"command": "MonorepoTools.installAllPackages",
				"title": "Install All Packages",
				"icon": "$(package)"
			},
			{
				"command": "MonorepoTools.installProjectPackage",
				"title": "Install a Package into this project",
				"icon": "$(package)"
			},
			{
				"command": "MonorepoTools.goToProject",
				"title": "Go To Project",
				"icon": "$(go-to-file)"
			},
			{
				"command": "MonorepoTools.buildProjects",
				"title": "Build Projects",
				"icon": "$(tools)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "MonorepoTools.refreshDependencies",
					"when": "view == monorepo-dependencies",
					"group": "navigation"
				},
				{
					"command": "MonorepoTools.installAllPackages",
					"when": "view == monorepo-dependencies",
					"group": "navigation"
				},
				{
					"command": "MonorepoTools.buildProjects",
					"when": "view == monorepo-dependencies",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "MonorepoTools.installProjectPackage",
					"when": "view == monorepo-dependencies && viewItem == project",
					"group": "inline@1"
				},
				{
					"command": "MonorepoTools.goToProject",
					"when": "view == monorepo-dependencies && viewItem == project",
					"group": "inline@2"
				}
			]
		},
		"configuration": [
			{
				"title": "Package Manager",
				"order": 1,
				"type": "object",
				"properties": {
					"MonorepoTools.packageManager": {
						"type": "string",
						"enum": [
							"npm",
							"pnpm",
							"bun"
						],
						"default": "npm",
						"order": 1,
						"markdownDescription": "Package Manager to use for commands."
					},
					"MonorepoTools.runScriptName": {
						"type": "string",
						"default": "dev",
						"order": 2,
						"markdownDescription": "Script to use when running applications locally."
					},
					"MonorepoTools.buildScriptName": {
						"type": "string",
						"default": "build",
						"order": 3,
						"markdownDescription": "Script to use when building applications."
					}
				}
			},
			{
				"title": "Annotations",
				"order": 2,
				"type": "object",
				"properties": {
					"MonorepoTools.annotations": {
						"order": 1,
						"markdownDescription": "Any entry that matches a script in the *package.json* file will be displayed as an inline file annotation.\n* `Item`: name of the script.\n* `Value`: description of the script",
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"dev": "run application in dev mode",
							"build": "build application for production mode"
						}
					},
					"MonorepoTools.hideAnnotations": {
						"order": 2,
						"markdownDescription": "Hide *package.json* file annotations",
						"type": "boolean",
						"default": false
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "pnpm run compile && pnpm run lint",
		"lint": "eslint .",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.134.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"eslint": "^10.5.0",
		"eslint-plugin-only-warn": "^1.2.1",
		"globals": "^17.11.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}